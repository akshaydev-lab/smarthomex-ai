+interface FirebaseCredentials {
+  projectId: string;
+  clientEmail: string;
+  privateKey: string;
+}
+
+interface FcmDispatchResult {
+  status: 'sent' | 'failed' | 'unconfigured' | 'no_tokens';
+  sentCount: number;
+  failedCount: number;
