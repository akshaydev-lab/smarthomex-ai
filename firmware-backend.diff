+void syncCloudSwitchProperties() {
+  isSyncingCloudProperties = true;
+  light = stateLight;
+  fan = stateFan;
+  motor = stateMotor;
+  streetLight = stateStreetLight;
+  exhaustFan = stateExhaust;
+  mq2RawADC = lastRawAdc;
